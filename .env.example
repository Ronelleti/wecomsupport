# Copy to .env.local and fill in (Supabase: Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Used only by `netlify dev` / the Netlify function (never commit real values, never prefix with VITE_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Web push (phone notifications). Generate keys with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://YOUR-SITE.netlify.app
PUSH_WEBHOOK_SECRET=
